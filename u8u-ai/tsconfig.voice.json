{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "dist",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "downlevelIteration": true
  },
  "include": [
    "voice-server.ts",
    "src/lib/voice/**/*.ts",
    "src/ai/**/*.ts"
  ]
}
